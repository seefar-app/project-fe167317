{
  "expo": {
    "name": "Saha Kitchen",
    "slug": "project-fe167317",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "sahakitchen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sahakitchen.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find kitchens near you and to pin your delivery address."
      }
    },
    "android": {
      "package": "com.sahakitchen.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Allow Saha Kitchen to use your location to find kitchens near you." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
